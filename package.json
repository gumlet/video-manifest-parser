{
  "name": "@gumlet/video-manifest-parser",
  "version": "1.0.4",
  "description": "A TypeScript package for manipulating MPD and M3U8 manifests",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ./src",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin main"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "m3u8-parser": "^7.2.0"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/m3u8-parser": "^7.2.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gumlet/video-manifest-parser.git"
  },
  "keywords": [
    "mpd",
    "m3u8",
    "manifest",
    "hls",
    "dash",
    "typescript",
    "parser"
  ],
  "standard-version": {
    "skip": {
      "tag": false
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
